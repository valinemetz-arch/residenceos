generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User Authentication
model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  password                String    // hashed
  name                    String?
  role                    String    @default("viewer") // owner, admin, viewer
  company                 String?
  isActive                Boolean   @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  createdBy               String?

  // Relations
  invitationsCreated      AdminInvitation[] @relation("InvitedBy")
  assignedTasks           Task[]    @relation("TaskAssignedToUser")
  tasksAssignedByMe       Task[]    @relation("TaskAssignedByUser")

  @@map("users")
}

// PLACES: Spaces (Rooms, Areas)
model Space {
  id            String    @id @default(cuid())
  name          String    // Kitchen, Primary Bath, etc
  building      String    @default("Main Residence")
  floor         String?   // 1st, 2nd, Basement
  squareFootage Float?
  description   String?
  status        String    @default("planned") // planned, in_progress, completed
  notes         String?

  // Project (for contractor portal)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Relations
  assets        Asset[]
  systems       System[]
  specifications Specification[]
  tasks         Task[]
  photos        Photo[]
  budgetItems   BudgetItem[]
  documents     Document[]
  warranties    Warranty[] @relation("SpaceWarranties")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("spaces")
}

// THINGS: Assets (Installed Products)
model Asset {
  id            String    @id @default(cuid())
  name          String    // Kitchen Faucet, Sub Zero Fridge, etc
  manufacturer  String?
  model         String?
  sku           String?
  finish        String?   // Chrome, Polished Nickel, etc
  
  // Financial
  cost          Float?
  vendor        String?
  purchaseDate  DateTime?
  installDate   DateTime?

  // Warranty & Maintenance
  warrantyMonths Int?
  warrantyExpires DateTime?
  manualUrl     String?
  replacementParts String? 

  // Location & System
  spaceId       String
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)

  // Data
  barcode       String?
  qrCode        String?   // Will generate this
  status        String    @default("pending") // pending, ordered, installed, operational
  notes         String?   

  // Relations
  specifications Specification[]
  photos        Photo[]
  documents     Document[]
  maintenance   Maintenance[]
  budgetItems   BudgetItem[]
  warranties    Warranty[] @relation("AssetWarranties")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("assets")
}

// PLACES: Building Systems
model System {
  id            String    @id @default(cuid())
  name          String    // HVAC, Electrical, Plumbing, Solar, Pool, etc
  description   String?   
  systemType    String    // For categorization

  // Relations
  assets        Asset[]
  spaces        Space[]
  specifications Specification[]
  photos        Photo[]
  documents     Document[]
  tasks         Task[]
  maintenance   Maintenance[]
  budgetItems   BudgetItem[]
  warranties    Warranty[] @relation("SystemWarranties")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("systems")
}

// KNOWLEDGE: Specifications (CSI Construction Bible)
model Specification {
  id            String    @id @default(cuid())
  csiDivision   String    // 22 = Plumbing, 26 = Electrical, etc
  trade         String    // Mechanical, Electrical, etc
  title         String    // "Hot Water Heater Specification"
  text          String     // Full specification text
  revisionNumber Int      @default(1)
  revisionDate  DateTime  @default(now())

  // Relations
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)

  assets        Asset[]
  photos        Photo[]
  documents     Document[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("specifications")
}

// WORK: Tasks (Design, Construction, Maintenance)
model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?   
  category      String    // design, construction, inspection, punchlist, warranty, maintenance
  priority      String    @default("medium") // low, medium, high, critical
  status        String    @default("pending") // pending, in_progress, completed, blocked
  
  // Dates
  dueDate       DateTime?
  completedDate DateTime?
  
  // Relations
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)

  // Assignment (either an internal team member OR a contractor, not both)
  assignedToUserId        String?
  assignedToUser          User?       @relation("TaskAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  assignedToContractorId  String?
  assignedToContractor    Contractor? @relation("TaskAssignedToContractor", fields: [assignedToContractorId], references: [id], onDelete: SetNull)

  assignedById            String?
  assignedByUser          User?       @relation("TaskAssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt              DateTime?

  photos        Photo[]
  documents     Document[]
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("tasks")
}

// KNOWLEDGE: Documents (Plans, Permits, PDFs)
model Document {
  id            String    @id @default(cuid())
  name          String
  type          String    // plan, permit, submittal, report, invoice, photo, other
  fileUrl       String
  fileName      String
  fileSize      Int?
  fileType      String?   // pdf, jpg, png, etc

  // Version Control
  versionNumber Int       @default(1)
  revisionDate  DateTime  @default(now())
  uploadedAt    DateTime  @default(now())
  uploadedBy    String?
  changeNotes   String?   // What changed in this version
  
  // Relations
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  
  assetId       String?
  asset         Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)
  
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  specificationId String?
  specification   Specification? @relation(fields: [specificationId], references: [id], onDelete: SetNull)

  milestoneId   String?
  milestone     Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  budgetItemId  String?
  budgetItem    BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)

  warrantyId    String?
  warranty      Warranty? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)

  // Contractor Portal
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  bidId         String?
  bid           Bid?      @relation(fields: [bidId], references: [id], onDelete: SetNull)

  contractId    String?
  contract      Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  changeOrderId String?
  changeOrder   ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  description   String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("documents")
}

// KNOWLEDGE: Photos (Project Gallery)
model Photo {
  id            String    @id @default(cuid())
  url           String
  caption       String?
  takeDate      DateTime  @default(now())
  constructionPhase String? // Foundation, Framing, Roof, etc
  
  // Auto-tagging
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  
  assetId       String?
  asset         Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)
  
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  specificationId String?
  specification Specification? @relation(fields: [specificationId], references: [id], onDelete: SetNull)

  milestoneId   String?
  milestone     Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  notes         String?   
  
  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  budgetItemId  String?
  budgetItem    BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)

  warrantyId    String?
  warranty      Warranty? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("photos")
}

// KNOWLEDGE: Budget Tracking
model BudgetItem {
  id            String    @id @default(cuid())
  category      String    // allowance, po, invoice, change_order
  description   String
  budgetedAmount Float
  actualAmount  Float?
  status        String    @default("pending") // pending, ordered, invoiced, paid

  // Relations
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  assetId       String?
  asset         Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)

  vendor        String?
  dueDate       DateTime?
  paidDate      DateTime?
  notes         String?

  // Attachments for invoices, bids, etc
  photos        Photo[]
  documents     Document[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("budget_items")
}

// KNOWLEDGE: Maintenance Schedule
model Maintenance {
  id            String    @id @default(cuid())
  title         String
  description   String?   
  interval      String    // monthly, quarterly, annual, etc
  
  // Relations
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)

  instructions  String?   
  lastCompleted DateTime?
  nextDue       DateTime?
  vendor        String?

  photos        Photo[]
  documents     Document[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("maintenance")
}

// Timeline / Milestones
model Milestone {
  id            String    @id @default(cuid())
  name          String    // Foundation, Framing, Roof, etc
  phase         Int       // 1, 2, 3, etc
  status        String    @default("pending") // pending, in_progress, completed
  startDate     DateTime?
  completedDate DateTime?
  description   String?

  photos        Photo[]
  documents     Document[]
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("milestones")
}

// WARRANTY MANAGEMENT
model Warranty {
  id            String    @id @default(cuid())
  title         String    // e.g., "Kitchen Faucet - 5 Year Warranty"

  // Coverage Details
  description   String?   // What's covered
  coverageScope String?   // Full, Limited, etc
  startDate     DateTime  // Warranty start date
  endDate       DateTime  // Warranty expiration date
  months        Int?      // Duration in months

  // Links to Assets/Systems
  assetId       String?
  asset         Asset?    @relation("AssetWarranties", fields: [assetId], references: [id], onDelete: SetNull)

  systemId      String?
  system        System?   @relation("SystemWarranties", fields: [systemId], references: [id], onDelete: SetNull)

  spaceId       String?
  space         Space?    @relation("SpaceWarranties", fields: [spaceId], references: [id], onDelete: SetNull)

  // Warranty Provider Info
  provider      String?   // Manufacturer name
  phone         String?
  email         String?
  website       String?
  claimProcess  String?   // How to file a claim
  serialNumber  String?
  proofOfPurchase String? // Invoice reference

  // Status Tracking
  status        String    @default("active") // active, expired, claimed, voided
  isExpired     Boolean   @default(false)

  // Documents (warranty cards, certificates, etc)
  documents     Document[]
  photos        Photo[]
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("warranties")
}

/// CONTRACTOR PORTAL: Projects
model Project {
  id            String    @id @default(cuid())
  name          String    // "123 Main St Renovation"
  address       String?
  description   String?
  budget        Float?
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("active") // active, closed, archived

  // Project Contents
  spaces        Space[]

  // Contractor Management
  documents     Document[]  // Plans, specs, schedules
  bids          Bid[]
  contracts     Contract[]  // Contracts for this project
  messages      Message[]   // Q&A messages
  trades        ProjectTrade[] // Required trades for this project

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("projects")
}

// TRADES: Trade specialties
model Trade {
  id            String    @id @default(cuid())
  name          String    @unique // Plumbing, Electrical, HVAC, etc.
  description   String?

  // Relations
  contractors   ContractorTrade[]
  projects      ProjectTrade[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("trades")
}

// CONTRACTOR TRADES: Junction table for contractor specialties
model ContractorTrade {
  id              String    @id @default(cuid())
  contractorId    String
  contractor      Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  tradeId         String
  trade           Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())

  @@unique([contractorId, tradeId])
  @@map("contractor_trades")
}

// PROJECT TRADES: Junction table for project requirements
model ProjectTrade {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tradeId         String
  trade           Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())

  @@unique([projectId, tradeId])
  @@map("project_trades")
}

// ADMIN INVITATIONS: Invite links for new admins
model AdminInvitation {
  id              String    @id @default(cuid())
  email           String    @unique
  code            String    @unique
  invitedBy       String
  invitedByUser   User      @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@map("admin_invitations")
}

/// CONTRACTOR PORTAL: Contractors
model Contractor {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String    // hashed
  companyName     String
  contactName     String?
  phone           String?
  address         String?
  role            String    @default("contractor") // contractor role

  // Contact Info
  website         String?
  logo            String?   // URL to logo image

  // Credentials
  licenseNumber   String?
  licenseExpiry   DateTime?
  licenseDocument String? // URL to uploaded license document
  insuranceExpiry DateTime?
  insuranceDocument String? // URL to uploaded insurance certificate

  // Bids & Contracts
  bids            Bid[]
  contracts       Contract[]
  documents       Document[]
  messages        Message[]

  // Trades
  trades          ContractorTrade[]

  // Task Assignment
  assignedTasks   Task[]    @relation("TaskAssignedToContractor")

  // Tracking
  lastAccessedAt  DateTime?
  lastReminderSentAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("contractors")
}

// CONTRACTOR PORTAL: Bids
model Bid {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  // Bid Details
  amount        Float
  notes         String?
  status        String    @default("pending") // pending, approved, rejected, withdrawn
  submittedAt   DateTime?

  // Document Versions at Time of Bid
  documentSnapshot String?  // JSON snapshot of document versions when bid was submitted
  // Example: [{ documentId, versionNumber, revisionDate, name }]

  // Related Documents
  documents     Document[]

  // Contract (if approved)
  contract      Contract?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("bids")
}

/// CONTRACTOR PORTAL: Contracts
model Contract {
  id            String    @id @default(cuid())

  // Relationships
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  bidId         String?   @unique
  bid           Bid?      @relation(fields: [bidId], references: [id], onDelete: SetNull)

  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  // DocuSign Integration
  envelopeId    String?   @unique  // DocuSign envelope ID
  signingUrl    String?   // Cached signing URL

  // Contract Details
  signerEmail   String
  signerName    String
  projectDetails Json?    // Store project info as JSON

  // Status tracking
  status        String    @default("sent") // sent, viewed, signed, completed, voided
  sentAt        DateTime  @default(now())
  signedAt      DateTime?
  completedAt   DateTime?

  // Document storage
  documentUrl   String?   // URL to signed PDF

  // Documents
  documents     Document[]
  changeOrders  ChangeOrder[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("contracts")
  @@index([contractorId])
  @@index([envelopeId])
  @@index([status])
}

// MESSAGING: Q&A between contractors and project owners
model Message {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  senderType    String    // "contractor" or "owner"
  senderName    String?   // Name of sender
  message       String    // Message content

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("messages")
}

// CHANGE ORDERS: Track scope & cost changes during construction
model ChangeOrder {
  id            String    @id @default(cuid())
  contractId    String
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  number        Int       // CO #1, #2, #3, etc.
  title         String    // "Upgrade electrical panel"
  description   String?   // Detailed scope of change

  // Cost & Schedule Impact
  originalCost  Float?    // Original line item cost
  adjustmentAmount Float  // Increase or decrease
  newCost       Float?    // New total cost
  scheduleImpact Int?     // Days added/reduced

  // Reason for Change
  reason        String?   // Design change, site condition, upgrade, etc.
  requestedBy   String?   // Owner, contractor, architect

  // Status & Approval
  status        String    @default("pending") // pending, approved, rejected, completed
  requestedAt   DateTime  @default(now())
  approvedAt    DateTime?
  approvedBy    String?
  completedAt   DateTime?

  // Documentation
  documents     Document[]
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("change_orders")
}

