generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User Authentication
model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  password                String    // hashed
  name                    String?
  role                    String    @default("viewer") // owner, admin, viewer
  company                 String?
  isActive                Boolean   @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  createdBy               String?

  // Relations
  invitationsCreated      AdminInvitation[] @relation("InvitedBy")
  assignedTasks           Task[]    @relation("TaskAssignedToUser")
  tasksAssignedByMe       Task[]    @relation("TaskAssignedByUser")

  @@map("users")
}

// PLACES: Spaces (Rooms, Areas)
model Space {
  id            String    @id @default(cuid())
  name          String    // Kitchen, Primary Bath, etc
  building      String    @default("Main Residence")
  floor         String?   // 1st, 2nd, Basement
  squareFootage Float?
  description   String?
  status        String    @default("planned") // planned, in_progress, completed
  notes         String?

  // Project (for contractor portal)
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Relations
  assets        Asset[]
  systems       System[]
  specifications Specification[]
  tasks         Task[]
  photos        Photo[]
  budgetItems   BudgetItem[]
  documents     Document[]
  warranties    Warranty[] @relation("SpaceWarranties")
  suggestedDocPages DocumentPage[] @relation("DocPageSuggestedSpace")
  confirmedDocPages DocumentPage[] @relation("DocPageConfirmedSpace")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("spaces")
}

// THINGS: Assets (Installed Products)
model Asset {
  id            String    @id @default(cuid())
  name          String    // Kitchen Faucet, Sub Zero Fridge, etc
  manufacturer  String?
  model         String?
  sku           String?
  finish        String?   // Chrome, Polished Nickel, etc
  size          String?   // Dimensions / selection size, e.g. 3'-0" x 6'-8", 36" wide
  
  // Financial
  cost          Float?
  vendor        String?
  purchaseDate  DateTime?
  installDate   DateTime?

  // Warranty & Maintenance
  warrantyMonths Int?
  warrantyExpires DateTime?
  manualUrl     String?
  replacementParts String? 

  // Location & System
  spaceId       String
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)
  tradeId       String?
  trade         Trade?    @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  // Data
  barcode       String?
  qrCode        String?   // Will generate this
  status        String    @default("pending") // pending, ordered, installed, operational
  notes         String?   // Install location, wiring/prewire needs, etc (e.g. "recessed ceiling speaker, patio north side, needs low-voltage run from AV closet")

  // Relations
  specifications Specification[]
  photos        Photo[]
  documents     Document[]
  maintenance   Maintenance[]
  budgetItems   BudgetItem[]
  warranties    Warranty[] @relation("AssetWarranties")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("assets")
}

// PLACES: Building Systems
model System {
  id            String    @id @default(cuid())
  name          String    // HVAC, Electrical, Plumbing, Solar, Pool, etc
  description   String?   
  systemType    String    // For categorization

  // Relations
  assets        Asset[]
  spaces        Space[]
  specifications Specification[]
  photos        Photo[]
  documents     Document[]
  tasks         Task[]
  maintenance   Maintenance[]
  budgetItems   BudgetItem[]
  warranties    Warranty[] @relation("SystemWarranties")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("systems")
}

// KNOWLEDGE: Specifications (CSI Construction Bible)
model Specification {
  id            String    @id @default(cuid())
  csiDivision   String    // 22 = Plumbing, 26 = Electrical, etc
  trade         String    // Mechanical, Electrical, etc
  title         String    // "Hot Water Heater Specification"
  text          String     // Full specification text
  revisionNumber Int      @default(1)
  revisionDate  DateTime  @default(now())

  // Relations
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)

  assets        Asset[]
  photos        Photo[]
  documents     Document[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("specifications")
}

// WORK: Tasks (Design, Construction, Maintenance)
model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?   
  category      String    // design, construction, inspection, punchlist, warranty, maintenance
  priority      String    @default("medium") // low, medium, high, critical
  status        String    @default("pending") // pending, in_progress, completed, blocked
  
  // Dates
  dueDate       DateTime?
  completedDate DateTime?
  
  // Relations
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)

  tradeId       String?
  trade         Trade?    @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  // Assignment (either an internal team member OR a contractor, not both)
  assignedToUserId        String?
  assignedToUser          User?       @relation("TaskAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  assignedToContractorId  String?
  assignedToContractor    Contractor? @relation("TaskAssignedToContractor", fields: [assignedToContractorId], references: [id], onDelete: SetNull)

  assignedById            String?
  assignedByUser          User?       @relation("TaskAssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt              DateTime?

  photos        Photo[]
  documents     Document[]
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("tasks")
}

// KNOWLEDGE: Documents (Plans, Permits, PDFs)
model Document {
  id            String    @id @default(cuid())
  name          String
  type          String    // plan, permit, submittal, report, invoice, photo, other
  fileUrl       String
  fileName      String
  fileSize      Int?
  fileType      String?   // pdf, jpg, png, etc

  // Version Control
  versionNumber Int       @default(1)
  revisionDate  DateTime  @default(now())
  uploadedAt    DateTime  @default(now())
  uploadedBy    String?
  changeNotes   String?   // What changed in this version
  
  // Relations
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  
  assetId       String?
  asset         Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)
  
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  specificationId String?
  specification   Specification? @relation(fields: [specificationId], references: [id], onDelete: SetNull)

  milestoneId   String?
  milestone     Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  budgetItemId  String?
  budgetItem    BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)

  warrantyId    String?
  warranty      Warranty? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)

  // Contractor Portal
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  bidId         String?
  bid           Bid?      @relation(fields: [bidId], references: [id], onDelete: SetNull)

  contractId    String?
  contract      Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  changeOrderId String?
  changeOrder   ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  // Field Reference: who can see this uploaded item - a whole Trade (group
  // of contractors, via tradeId), one specific Contractor (via the existing
  // contractorId above), or every contractor regardless of trade
  // (visibleToAll). Independent of Space, which is "where", not "who".
  tradeId       String?
  trade         Trade?    @relation("DocumentTrade", fields: [tradeId], references: [id], onDelete: SetNull)
  visibleToAll  Boolean   @default(false)

  description   String?

  planSets      PlanSet[] // source PDF for a floor-plan takeoff extraction
  pages         DocumentPage[] // per-page split + AI space/trade tagging, for Field Reference

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("documents")
}

// FIELD REFERENCE: one rendered page from a multi-page spec/interior-elevation
// PDF, split page-by-page (same pipeline as PlanSet/PlanPage) and tagged with
// the Space + Trade it depicts so a contractor or the homeowner/GC can pull up
// "Primary Bathroom" or "Plumbing" and see exactly the right sheet. AI
// suggests a tag per page; an admin confirms (or corrects) it before the page
// is surfaced on the Field Reference page.
model DocumentPage {
  id            String    @id @default(cuid())

  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  pageNumber    Int
  imageUrl      String    // rendered PNG, stored in Vercel Blob
  status        String    @default("pending") // pending, tagged, failed

  // AI-suggested tags (set once the page has been auto-tagged)
  suggestedSpaceId String?
  suggestedSpace    Space?  @relation("DocPageSuggestedSpace", fields: [suggestedSpaceId], references: [id], onDelete: SetNull)
  suggestedTradeId String?
  suggestedTrade    Trade?  @relation("DocPageSuggestedTrade", fields: [suggestedTradeId], references: [id], onDelete: SetNull)
  suggestedNote     String? // brief AI rationale, e.g. "Primary Bathroom, Elevation C - shower valve + tile"

  // Confirmed tags - only pages with a confirmed trade or space show up on
  // the Field Reference page. Starts null even if a suggestion exists.
  confirmedSpaceId String?
  confirmedSpace    Space?  @relation("DocPageConfirmedSpace", fields: [confirmedSpaceId], references: [id], onDelete: SetNull)
  confirmedTradeId String?
  confirmedTrade    Trade?  @relation("DocPageConfirmedTrade", fields: [confirmedTradeId], references: [id], onDelete: SetNull)
  confirmed         Boolean @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([documentId, pageNumber])
  @@map("document_pages")
}

// KNOWLEDGE: Photos (Project Gallery)
model Photo {
  id            String    @id @default(cuid())
  url           String
  caption       String?
  takeDate      DateTime  @default(now())
  constructionPhase String? // Foundation, Framing, Roof, etc
  
  // Auto-tagging
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  
  assetId       String?
  asset         Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)
  
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  specificationId String?
  specification Specification? @relation(fields: [specificationId], references: [id], onDelete: SetNull)

  milestoneId   String?
  milestone     Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  notes         String?   
  
  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  budgetItemId  String?
  budgetItem    BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)

  warrantyId    String?
  warranty      Warranty? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("photos")
}

// KNOWLEDGE: Budget Tracking
model BudgetItem {
  id            String    @id @default(cuid())
  category      String    // allowance, po, invoice, change_order
  description   String
  budgetedAmount Float
  actualAmount  Float?
  status        String    @default("pending") // pending, ordered, invoiced, paid

  // Relations
  spaceId       String?
  space         Space?    @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  assetId       String?
  asset         Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)

  vendor        String?
  dueDate       DateTime?
  paidDate      DateTime?
  notes         String?

  // Attachments for invoices, bids, etc
  photos        Photo[]
  documents     Document[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("budget_items")
}

// KNOWLEDGE: Maintenance Schedule
model Maintenance {
  id            String    @id @default(cuid())
  title         String
  description   String?   
  interval      String    // monthly, quarterly, annual, etc
  
  // Relations
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  systemId      String?
  system        System?   @relation(fields: [systemId], references: [id], onDelete: SetNull)

  instructions  String?   
  lastCompleted DateTime?
  nextDue       DateTime?
  vendor        String?

  photos        Photo[]
  documents     Document[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("maintenance")
}

// Timeline / Milestones
model Milestone {
  id            String    @id @default(cuid())
  name          String    // Foundation, Framing, Roof, etc
  phase         Int       // 1, 2, 3, etc
  status        String    @default("pending") // pending, in_progress, completed
  startDate     DateTime?
  completedDate DateTime?
  description   String?

  photos        Photo[]
  documents     Document[]
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("milestones")
}

// WARRANTY MANAGEMENT
model Warranty {
  id            String    @id @default(cuid())
  title         String    // e.g., "Kitchen Faucet - 5 Year Warranty"

  // Coverage Details
  description   String?   // What's covered
  coverageScope String?   // Full, Limited, etc
  startDate     DateTime  // Warranty start date
  endDate       DateTime  // Warranty expiration date
  months        Int?      // Duration in months

  // Links to Assets/Systems
  assetId       String?
  asset         Asset?    @relation("AssetWarranties", fields: [assetId], references: [id], onDelete: SetNull)

  systemId      String?
  system        System?   @relation("SystemWarranties", fields: [systemId], references: [id], onDelete: SetNull)

  spaceId       String?
  space         Space?    @relation("SpaceWarranties", fields: [spaceId], references: [id], onDelete: SetNull)

  // Warranty Provider Info
  provider      String?   // Manufacturer name
  phone         String?
  email         String?
  website       String?
  claimProcess  String?   // How to file a claim
  serialNumber  String?
  proofOfPurchase String? // Invoice reference

  // Status Tracking
  status        String    @default("active") // active, expired, claimed, voided
  isExpired     Boolean   @default(false)

  // Documents (warranty cards, certificates, etc)
  documents     Document[]
  photos        Photo[]
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("warranties")
}

/// CONTRACTOR PORTAL: Projects
model Project {
  id            String    @id @default(cuid())
  name          String    // "123 Main St Renovation"
  address       String?
  description   String?
  budget        Float?
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("active") // active, closed, archived

  // Site Info (Owner Dashboard / Contractor Portal "Project" tab)
  gateCode      String?
  phase         String?   // current construction phase label, e.g. "Framing & Rough-In"

  // Project Contents
  spaces        Space[]

  // Contractor Management
  documents     Document[]  // Plans, specs, schedules
  bids          Bid[]
  contracts     Contract[]  // Contracts for this project
  messages      Message[]   // Q&A messages
  trades        ProjectTrade[] // Required trades for this project
  planSets      PlanSet[]   // Uploaded floor-plan sets for AI takeoff extraction
  timelineSteps ProjectTimelineStep[]
  contacts      ProjectContact[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("projects")
}

// SITE INFO: Construction timeline milestones shown in the Owner Dashboard /
// Contractor Portal "Project" tab. `dateLabel` is free text because entries
// mix real dates ("Sep 2026") with status words ("Complete", "In progress").
model ProjectTimelineStep {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  label         String
  dateLabel     String
  order         Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("project_timeline_steps")
}

// SITE INFO: GC/homeowner/PM contacts shown alongside Site Info.
model ProjectContact {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name          String
  role          String
  phone         String
  order         Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("project_contacts")
}

// TRADES: Trade specialties
model Trade {
  id            String    @id @default(cuid())
  name          String    @unique // Plumbing, Electrical, HVAC, etc.
  description   String?

  // Relations
  contractors   ContractorTrade[]
  projects      ProjectTrade[]
  assets        Asset[]
  tasks         Task[]
  takeoffItems  TakeoffItem[]
  documents     Document[] @relation("DocumentTrade")
  suggestedDocPages DocumentPage[] @relation("DocPageSuggestedTrade")
  confirmedDocPages DocumentPage[] @relation("DocPageConfirmedTrade")
  resourceAccess TradeResourceAccess[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("trades")
}

// FIELD REFERENCE ACCESS: an additive "also visible to this trade" grant,
// layered on top of a resource's primary trade tag (Asset.tradeId,
// Document.tradeId, DocumentPage.confirmedTradeId). Lets the owner hand-pick
// extra assets/specs a trade should see beyond what auto-tagging already
// covers, from the Trade Access admin page, without disturbing the primary
// tag that page/asset/document editing sets elsewhere.
model TradeResourceAccess {
  id            String    @id @default(cuid())

  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  resourceType  String    // "asset" | "document" | "documentPage"
  resourceId    String

  createdAt     DateTime  @default(now())

  @@unique([tradeId, resourceType, resourceId])
  @@map("trade_resource_access")
}

// FLOOR-PLAN TAKEOFFS: an uploaded plan set (PDF), rendered page-by-page and
// run through AI extraction to stage material/quantity takeoff items for
// review before a project goes out to bid.
model PlanSet {
  id            String    @id @default(cuid())
  name          String    // e.g. "7/22/26 Permit Set"

  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  documentId    String?   // the uploaded source PDF
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  status        String    @default("rendering") // rendering, extracting, ready, failed

  pages         PlanPage[]
  items         TakeoffItem[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("plan_sets")
}

// One rendered page image from a PlanSet's source PDF.
model PlanPage {
  id            String    @id @default(cuid())

  planSetId     String
  planSet       PlanSet   @relation(fields: [planSetId], references: [id], onDelete: Cascade)

  pageNumber    Int
  imageUrl      String    // rendered PNG, stored in Vercel Blob
  status        String    @default("pending") // pending, processed, skipped, failed

  items         TakeoffItem[]

  createdAt     DateTime  @default(now())

  @@unique([planSetId, pageNumber])
  @@map("plan_pages")
}

// A single AI-extracted (or manually added) takeoff line item, staged for
// owner review before it's trusted as real project scope.
model TakeoffItem {
  id            String    @id @default(cuid())

  planSetId     String
  planSet       PlanSet   @relation(fields: [planSetId], references: [id], onDelete: Cascade)

  planPageId    String?
  planPage      PlanPage? @relation(fields: [planPageId], references: [id], onDelete: SetNull)

  tradeId       String?
  trade         Trade?    @relation(fields: [tradeId], references: [id], onDelete: SetNull)

  description   String    // "Door 03 - Living Room, 3'-0 x 6'-8, folding glass"
  quantity      Float?
  unit          String?   // each, sq ft, linear ft

  confidence    String    // high, medium, low, manual_required, needs_info
  sourceNote    String?   // AI citation or clarifying question

  status        String    @default("pending") // pending, confirmed, rejected

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("takeoff_items")
}

// CONTRACTOR TRADES: Junction table for contractor specialties
model ContractorTrade {
  id              String    @id @default(cuid())
  contractorId    String
  contractor      Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  tradeId         String
  trade           Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())

  @@unique([contractorId, tradeId])
  @@map("contractor_trades")
}

// PROJECT TRADES: Junction table for project requirements
model ProjectTrade {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  tradeId         String
  trade           Trade     @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())

  @@unique([projectId, tradeId])
  @@map("project_trades")
}

// ADMIN INVITATIONS: Invite links for new admins
model AdminInvitation {
  id              String    @id @default(cuid())
  email           String    @unique
  code            String    @unique
  invitedBy       String
  invitedByUser   User      @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@map("admin_invitations")
}

/// CONTRACTOR PORTAL: Contractors
model Contractor {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String    // hashed
  companyName     String
  contactName     String?
  phone           String?
  address         String?
  role            String    @default("contractor") // contractor role

  // Contact Info
  website         String?
  logo            String?   // URL to logo image

  // Credentials
  licenseNumber   String?
  licenseExpiry   DateTime?
  licenseDocument String? // URL to uploaded license document
  insuranceExpiry DateTime?
  insuranceDocument String? // URL to uploaded insurance certificate

  // Bids & Contracts
  bids            Bid[]
  contracts       Contract[]
  documents       Document[]
  messages        Message[]

  // Trades
  trades          ContractorTrade[]

  // Task Assignment
  assignedTasks   Task[]    @relation("TaskAssignedToContractor")

  // Tracking
  lastAccessedAt  DateTime?
  lastReminderSentAt DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("contractors")
}

// CONTRACTOR PORTAL: Bids
model Bid {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  // Bid Details
  amount        Float
  notes         String?
  includesInstallation Boolean? // whether this bid amount includes installation labor
  installEstimate      String?  // free-text time estimate, e.g. "2 days", "16-20 hrs"
  status        String    @default("pending") // pending, approved, rejected, withdrawn
  submittedAt   DateTime?

  // Document Versions at Time of Bid
  documentSnapshot String?  // JSON snapshot of document versions when bid was submitted
  // Example: [{ documentId, versionNumber, revisionDate, name }]

  // Related Documents
  documents     Document[]

  // Contract (if approved)
  contract      Contract?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("bids")
}

/// CONTRACTOR PORTAL: Contracts
model Contract {
  id            String    @id @default(cuid())

  // Relationships
  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  bidId         String?   @unique
  bid           Bid?      @relation(fields: [bidId], references: [id], onDelete: SetNull)

  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  // DocuSign Integration
  envelopeId    String?   @unique  // DocuSign envelope ID
  signingUrl    String?   // Cached signing URL

  // Contract Details
  signerEmail   String
  signerName    String
  projectDetails Json?    // Store project info as JSON

  // Status tracking
  status        String    @default("sent") // sent, viewed, signed, completed, voided
  sentAt        DateTime  @default(now())
  signedAt      DateTime?
  completedAt   DateTime?

  // Document storage
  documentUrl   String?   // URL to signed PDF

  // Documents
  documents     Document[]
  changeOrders  ChangeOrder[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("contracts")
  @@index([contractorId])
  @@index([envelopeId])
  @@index([status])
}

// MESSAGING: Q&A between contractors and project owners
model Message {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id], onDelete: SetNull)

  senderType    String    // "contractor" or "owner"
  senderName    String?   // Name of sender
  message       String    // Message content

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("messages")
}

// CHANGE ORDERS: Track scope & cost changes during construction
model ChangeOrder {
  id            String    @id @default(cuid())
  contractId    String
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  number        Int       // CO #1, #2, #3, etc.
  title         String    // "Upgrade electrical panel"
  description   String?   // Detailed scope of change

  // Cost & Schedule Impact
  originalCost  Float?    // Original line item cost
  adjustmentAmount Float  // Increase or decrease
  newCost       Float?    // New total cost
  scheduleImpact Int?     // Days added/reduced

  // Reason for Change
  reason        String?   // Design change, site condition, upgrade, etc.
  requestedBy   String?   // Owner, contractor, architect

  // Status & Approval
  status        String    @default("pending") // pending, approved, rejected, completed
  requestedAt   DateTime  @default(now())
  approvedAt    DateTime?
  approvedBy    String?
  completedAt   DateTime?

  // Documentation
  documents     Document[]
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("change_orders")
}

